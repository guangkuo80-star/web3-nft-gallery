# ─────────────────────────────────────────────────────────────
# web3-nft-gallery — environment variables template
#
# 1. Copy this file to `.env.local` (gitignored) and fill values.
# 2. NEVER commit `.env.local`. NEVER paste your private key
#    into a chat, screenshot, or public repo.
# 3. On Vercel: Project → Settings → Environment Variables,
#    add every `NEXT_PUBLIC_*` key (private keys are only needed
#    locally for Hardhat deploy — Vercel does NOT need them).
# ─────────────────────────────────────────────────────────────

# ─── FRONTEND (exposed to browser, all NEXT_PUBLIC_*) ────────

# Deployed MyNFT contract address on Sepolia.
# After `npm run deploy:sepolia`, copy the printed address here
# AND into `lib/deployments/sepolia.json`.
NEXT_PUBLIC_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# Public RPC used by the browser (wagmi). Free tier is fine.
# Get one at https://dashboard.alchemy.com → Create App → Sepolia
NEXT_PUBLIC_SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_API_KEY

# WalletConnect / Reown project id — required by RainbowKit.
# Get one free at https://cloud.reown.com (formerly WalletConnect Cloud)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_project_id_here

# ─── CONTRACT DEPLOYMENT (LOCAL ONLY — never upload) ─────────

# Sepolia RPC used by Hardhat when deploying. Can reuse the same Alchemy URL.
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_API_KEY

# ⚠️⚠️⚠️ PRIVATE KEY OF THE DEPLOYER WALLET ⚠️⚠️⚠️
# Use a THROWAWAY wallet funded with Sepolia testnet ETH only.
# Get Sepolia ETH: https://faucets.chain.link/sepolia
# NEVER use your mainnet key. NEVER commit this file.
DEPLOYER_PRIVATE_KEY=

# Optional: Etherscan API key to auto-verify contract on deploy.
# Get one at https://etherscan.io/myapikey
ETHERSCAN_API_KEY=

# Optional: override token name / symbol / base URI at deploy time.
NFT_NAME=My Demo NFT
NFT_SYMBOL=MDN
NFT_BASE_URI=ipfs://QmTz1GxqvzVrYhRY6Q2eaNnCJ4dZeFXFR6MJdWqYxD8n3U/
